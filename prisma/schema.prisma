generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?   @map("password_hash")
  name         String?
  role         String    @default("user")
  points       Int       @default(0)
  googleId     String?   @unique @map("google_id")
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  pointLogs           PointLog[]
  paymentRequests     PaymentRequest[]
  webauthnCredentials WebAuthnCredential[]
  aiUsages            AiUsage[]

  @@map("User")
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key")
  counter      BigInt   @default(0)
  transports   String?
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("WebAuthnCredential")
}

model Content {
  id          String   @id @default(cuid())
  title       String
  type        String
  description String?
  coverUrl    String?  @map("cover_url")
  linkUrl     String   @map("link_url")
  linkType    String   @default("stream") @map("link_type")
  category    String?
  status      String   @default("published")
  pointsCost  Int      @default(0) @map("points_cost")
  apiSource   String?  @map("api_source")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([status])
  @@index([updatedAt])
  @@map("Content")
}

model ApiSource {
  id        String   @id @default(cuid())
  category  String
  name      String
  url       String   @default("")
  enabled   Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("ApiSource")
}

model ViewSession {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  section   String
  title     String?
  path      String?
  lastSeen  DateTime @default(now()) @map("last_seen")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sessionId, section])
  @@index([section])
  @@index([lastSeen])
  @@map("ViewSession")
}

model PointLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  amount    Int
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("PointLog")
}

model AiUsage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  userId    String?  @map("user_id")
  kind      String
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
  @@map("AiUsage")
}

model PaymentRequest {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  amount        Int
  status        String   @default("pending")
  contentType   String   @default("movie") @map("content_type")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("PaymentRequest")
}

model VpnConfig {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  title        String
  configText   String   @map("config_text")
  packageDays  Int      @default(0) @map("package_days")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("VpnConfig")
}

model Presence {
  id           String   @id @default(cuid())
  sessionId    String   @unique @map("session_id")
  userId       String?  @map("user_id")
  path         String?
  deviceType   String?  @map("device_type")
  lastSeen     DateTime @default(now()) @map("last_seen")

  @@index([lastSeen])
  @@map("Presence")
}
