generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?   @map("password_hash")
  name         String?   @map("full_name")
  role         String    @default("user")
  points       Int       @default(10)
  googleId     String?   @unique @map("google_id")
  avatarUrl    String?   @map("avatar_url")
  inviteCode   String?   @map("invite_code")
  referredById String?   @map("referred_by_id")
  packagePoints Int      @default(0) @map("package_points")
  packagePointsExpiresAt DateTime? @map("package_points_expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  pointLogs           PointLog[]
  paymentRequests     PaymentRequest[]
  webauthnCredentials WebAuthnCredential[]
  aiUsages            AiUsage[]
  accesses            UserAccess[]
  playbackReports     PlaybackReport[]

  @@map("User")
}

model PointLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  amount    Int
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("PointLog")
}

model AiUsage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  userId    String?  @map("user_id")
  kind      String
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
  @@map("AiUsage")
}

model Content {
  id          String   @id @default(cuid())
  title       String
  type        String
  description String?
  coverUrl    String?  @map("cover_url")
  linkUrl     String   @map("link_url")
  linkType    String   @default("stream") @map("link_type")
  category    String?
  status      String   @default("published")
  pointsCost  Int      @default(0) @map("points_cost")
  apiSource   String?  @map("api_source")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  accesses        UserAccess[]
  playbackReports PlaybackReport[]
  paymentRequests PaymentRequest[]

  @@index([type])
  @@index([status])
  @@index([updatedAt])
  @@map("Content")
}

model ApiSource {
  id        String   @id @default(cuid())
  category  String
  name      String
  url       String   @default("")
  enabled   Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("ApiSource")
}

model ViewSession {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  section   String
  title     String?
  path      String?
  lastSeen  DateTime @default(now()) @map("last_seen")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("ViewSession")
}

model PaymentRequest {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  contentId  String?  @map("content_id")
  amount     Int      @map("amount_tzs")
  status     String   @default("pending")
  notes      String?  @map("note")
  packageKey String?  @map("package_key")
  proofUrl   String?  @map("proof_url")
  adminNote  String?  @map("admin_note")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("PaymentRequest")
}

model UserAccess {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  contentId String?   @map("content_id")
  expiresAt DateTime? @map("expires_at")
  kind      String    @default("content")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("UserAccess")
}

model PlaybackReport {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  contentId String?  @map("content_id")
  reason    String?
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  content Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("PlaybackReport")
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key")
  counter      BigInt   @default(0)
  transports   String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("WebAuthnCredential")
}

model PaymentSettings {
  id                 String  @id @default("default")
  enabled            Boolean @default(false)
  payPhone           String  @default("") @map("pay_phone")
  payNetwork         String  @default("vodacom") @map("pay_network")
  priceWeek          Int     @default(2000) @map("price_week")
  priceMonth         Int     @default(5000) @map("price_month")
  priceYear          Int     @default(40000) @map("price_year")
  priceOnce          Int     @default(1000) @map("price_once")
  instructions       String?
  paidCategories     String  @default("movie,drama,tv,music,radio,game") @map("paid_categories")
  showPackages       Boolean @default(false) @map("show_packages")
  pointsAdsEnabled   Boolean @default(true) @map("points_ads_enabled")
  vpnPackages        String? @map("vpn_packages")

  @@map("PaymentSettings")
}
