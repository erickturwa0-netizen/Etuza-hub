generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  fullName               String?   @map("full_name")
  role                   String    @default("user")
  points                 Int       @default(10)
  packagePoints          Int       @default(0) @map("package_points")
  packagePointsExpiresAt DateTime? @map("package_points_expires_at")
  inviteCode             String?   @unique @map("invite_code")
  referredById           String?   @map("referred_by_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  pointLogs             PointLog[]
  paymentRequests       PaymentRequest[]
  accesses              UserAccess[]
  playbackReports       PlaybackReport[]
  aiUsages              AiUsage[]
  webAuthnCredentials   WebAuthnCredential[]

  @@map("User")
}

model PointLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  amount    Int
  reason    String
  meta      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("PointLog")
}

model AiUsage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  userId    String?  @map("user_id")
  kind      String   @default("chat")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
  @@map("AiUsage")
}

model Content {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String?
  coverUrl    String?  @map("cover_url")
  linkUrl     String   @map("link_url")
  linkType    String   @default("stream") @map("link_type")
  category    String?
  status      String   @default("draft")
  protocol    String?
  country     String?
  network     String?
  configText  String?  @map("config_text")
  fileUrl     String?  @map("file_url")
  priceMode   String   @default("free") @map("price_mode")
  priceTzs    Int      @default(0) @map("price_tzs")
  accessDays  Int      @default(0) @map("access_days")
  vpnPackages String?  @map("vpn_packages") @db.Text
  viewsCount  Int      @default(0) @map("views_count")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  paymentRequests PaymentRequest[]
  accesses        UserAccess[]
  playbackReports PlaybackReport[]

  @@index([type])
  @@index([status])
  @@map("Content")
}

model ApiSource {
  id        String   @id @default(cuid())
  category  String   @unique
  name      String
  url       String   @default("")
  enabled   Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ApiSource")
}

model ViewSession {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  section   String
  title     String?
  path      String?
  lastSeen  DateTime @default(now()) @map("last_seen")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sessionId, section])
  @@index([section])
  @@index([lastSeen])
  @@map("ViewSession")
}

model PaymentRequest {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  contentId   String?  @map("content_id")
  amountTzs   Int      @map("amount_tzs")
  packageKey  String?  @map("package_key")
  status      String   @default("pending")
  proofUrl    String?  @map("proof_url")
  note        String?
  adminNote   String?  @map("admin_note")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("PaymentRequest")
}

model UserAccess {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  contentId String?  @map("content_id")
  kind      String   @default("content")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contentId])
  @@map("UserAccess")
}

model PlaybackReport {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  contentId     String?  @map("content_id")
  contentKey    String   @map("content_key")
  contentTitle  String   @map("content_title")
  contentType   String   @default("movie") @map("content_type")
  note          String?  @db.Text
  screenshotUrl String?  @map("screenshot_url") @db.Text
  status        String   @default("pending")
  adminNote     String?  @map("admin_note")
  refundPoints  Int      @default(1) @map("refund_points")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("PlaybackReport")
}

/** Device fingerprint / passkey (WebAuthn) — phone fingerprint / Face ID */
model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key") @db.Text
  counter      Int      @default(0)
  deviceType   String?  @map("device_type")
  backedUp     Boolean  @default(false) @map("backed_up")
  transports   String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("WebAuthnCredential")
}
