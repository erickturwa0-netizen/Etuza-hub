generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String?  @map("full_name")
  role         String   @default("user")
  points       Int      @default(10)
  inviteCode   String?  @unique @map("invite_code")
  referredById String?  @map("referred_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  pointLogs        PointLog[]
  paymentRequests  PaymentRequest[]
  accesses         UserAccess[]

  @@map("User")
}

model PointLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  amount    Int
  reason    String
  meta      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("PointLog")
}

model Content {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String?
  coverUrl    String?  @map("cover_url")
  linkUrl     String   @map("link_url")
  linkType    String   @default("stream") @map("link_type")
  category    String?
  status      String   @default("draft")
  protocol    String?
  country     String?
  network     String?
  configText  String?  @map("config_text")
  fileUrl     String?  @map("file_url")
  /** free | once | week | month | year */
  priceMode   String   @default("free") @map("price_mode")
  /** TZS price for this item (0 = use global package price) */
  priceTzs    Int      @default(0) @map("price_tzs")
  viewsCount  Int      @default(0) @map("views_count")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  paymentRequests PaymentRequest[]
  accesses        UserAccess[]

  @@index([type])
  @@index([status])
  @@map("Content")
}

model ApiSource {
  id        String   @id @default(cuid())
  category  String   @unique
  name      String   @default("")
  url       String   @default("")
  enabled   Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ApiSource")
}

model ViewSession {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  section   String
  title     String?
  path      String?
  lastSeen  DateTime @default(now()) @map("last_seen")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sessionId, section])
  @@index([section])
  @@index([lastSeen])
  @@map("ViewSession")
}

/** Global payment settings (single row id=default) */
model PaymentSettings {
  id           String   @id @default("default")
  enabled      Boolean  @default(false)
  payPhone     String   @default("") @map("pay_phone")
  payNetwork   String   @default("vodacom") @map("pay_network")
  priceWeek    Int      @default(2000) @map("price_week")
  priceMonth   Int      @default(5000) @map("price_month")
  priceYear    Int      @default(40000) @map("price_year")
  priceOnce    Int      @default(1000) @map("price_once")
  instructions String?  @default("Tuma pesa kisha pakia screenshot ya muamala.")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("PaymentSettings")
}

model PaymentRequest {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  contentId      String?  @map("content_id")
  plan           String
  amount         Int
  senderPhone    String   @map("sender_phone")
  senderNetwork  String   @map("sender_network")
  screenshotUrl  String   @map("screenshot_url") @db.Text
  status         String   @default("pending")
  adminNote      String?  @map("admin_note")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("PaymentRequest")
}

model UserAccess {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  contentId String?   @map("content_id")
  plan      String
  /** null contentId = site-wide access for plan duration */
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contentId])
  @@map("UserAccess")
}
